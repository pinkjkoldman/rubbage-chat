[network]
bootstrapUrl=
host=127.0.0.1
chatPort=7502
locked=false

[database]
mongoUri=mongodb://127.0.0.1:27017/?serverSelectionTimeoutMS=3000
name=rubbagechat

[security]
tls=false
certificateFile=
privateKeyFile=
publicMode=false
registrationEnabled=true
maxConnections=500
maxConnectionsPerIp=12

[performance]
businessWorkers=8
maxPendingCommands=2000

[storage]
attachmentRoot=

[development]
seedDemoAccounts=false
