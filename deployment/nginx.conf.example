events {
    worker_connections 8192;
}

stream {
    upstream rubbagechat_gateway {
        least_conn;
        server 127.0.0.1:7502 max_fails=3 fail_timeout=10s;
    }

    server {
        listen 443 reuseport;
        proxy_connect_timeout 5s;
        proxy_timeout 120s;
        proxy_pass rubbagechat_gateway;
    }
}

http {
    server {
        listen 80;
        server_name config.example.com;

        location = /.well-known/rubbagechat/client {
            default_type application/json;
            add_header Cache-Control "public, max-age=300";
            alias /etc/rubbagechat/bootstrap.json;
        }

        location = /healthz {
            return 200 "ok\n";
        }
    }
}
